{
  "name": "crisp-game-lib-playlog-eval-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vendor": "npm --prefix vendor/crisp-game-lib run build",
    "intake:batch": "node scripts/intake-batch-games.mjs",
    "check:annotation-diff": "node scripts/check-annotation-diff.mjs",
    "retain:round": "node scripts/retain-round.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "render:play-log-quality": "node scripts/render-play-log-analysis.mjs",
    "evaluate:play-log-quality": "node scripts/evaluate-play-log-quality.mjs",
    "measure:control-dominance": "node scripts/measure-control-dominance.mjs",
    "rank:play-logs": "node scripts/rank-play-log-quality.mjs",
    "verify:play-log-ranking-hashes": "node scripts/verify-play-log-ranking-hashes.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test"
