{
  "name": "claude-one-button-game-creation",
  "version": "1.0.0",
  "description": "Generate batches of browser-playable one-button crisp-game-lib games.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abagames/claude-one-button-game-creation.git"
  },
  "scripts": {
    "skills:install": "bash scripts/install_agent_skills.sh",
    "skills:check": "bash scripts/install_agent_skills.sh --check",
    "tags": "node scripts/random_tag_selector.js",
    "smoke": "npm run skills:check && node .agents/skills/smoke-testing-web-games/scripts/smoke-test.mjs",
    "batch:check": "npm run skills:check && node scripts/check_batch.js",
    "eval:setup": "npm --prefix evaluation ci --ignore-scripts && npm --prefix evaluation test",
    "eval:intake": "npm --prefix evaluation run intake:batch --",
    "eval:run": "npm --prefix evaluation run evaluate:play-log-quality --",
    "eval:rank": "npm --prefix evaluation run rank:play-logs --",
    "test:smoke": "npm run skills:check && node .agents/skills/smoke-testing-web-games/scripts/smoke-test.mjs .agents/skills/smoke-testing-web-games/assets/fixtures/fixture-ok.html",
    "playwright:install": "playwright install chromium",
    "test": "npm run test:smoke"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
