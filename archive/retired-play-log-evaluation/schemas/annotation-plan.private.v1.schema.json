{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crisp-meta-workflow/annotation-plan.private.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "original_source_sha256", "instrumented_source_sha256", "scopes", "unresolved_geometry", "nested_scopes", "non_annotation_diff_count"],
  "properties": {
    "schema_version": { "const": 1 },
    "original_source_sha256": { "$ref": "#/$defs/sha256" },
    "instrumented_source_sha256": { "$ref": "#/$defs/sha256" },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "private_role", "identity_kind", "drawing_calls", "collision_return_preserved", "confidence"],
        "properties": {
          "scope_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "private_role": { "type": "string", "minLength": 1 },
          "identity_kind": { "enum": ["group_label", "explicit_id", "object_reference"] },
          "drawing_calls": { "type": "array", "minItems": 1, "items": { "enum": ["rect", "box", "bar", "line", "arc", "char", "text"] } },
          "collision_return_preserved": { "type": "boolean" },
          "confidence": { "enum": ["confirmed", "ambiguous"] }
        }
      }
    },
    "unresolved_geometry": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nested_scopes": { "const": false },
    "non_annotation_diff_count": { "const": 0 }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
